{
  "name": "eurobond-crm",
  "private": true,
  "version": "1.7.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "postinstall": "node scripts/patch-bg-geo.cjs",
    "_comment_android": "One command for an APK. The patch script has to run between the web build and the Capacitor sync: it is what writes the version into android/app/build.gradle and applies the tracking patches. It used to run only on npm install, so a version bump never reached the installed app — it said 1.6.2 while the web app said 1.6.3.",
    "android": "vite build && node scripts/patch-bg-geo.cjs && npx cap sync android"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/app-launcher": "^8.0.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/device": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capawesome-team/capacitor-android-battery-optimization": "^8.0.1",
    "@capawesome-team/capacitor-android-foreground-service": "^7.0.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.428.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.12.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0"
  }
}